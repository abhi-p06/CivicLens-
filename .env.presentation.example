# ==============================================================================
# CIVILENS — ACADEMIC PRESENTATION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Use this configuration file to start a clean, empty presentation environment
# for academic and project evaluation viva demonstrations.
#
# Focus:
# 1. Pothole and road-damage detection (RDD2022 YOLOv8s)
# 2. Garbage accumulation and litter detection (TACO YOLO11s)
#
# To use:
#   cp .env.presentation.example .env.presentation
#   export $(cat .env.presentation | xargs)
# ==============================================================================

# Server Network Configuration
CIVILENS_PORT=8000
CIVILENS_HOST="0.0.0.0"
CIVILENS_ENV="development"

# Presentation Mode Activation
# Points to separate data/civilens_presentation.db and disables seed complaint records
CIVILENS_PRESENTATION_MODE=true
SEED_COMPLAINTS_ON_STARTUP=false
CIVILENS_DB_PATH="data/civilens_presentation.db"
CIVILENS_UPLOAD_DIR="uploads_presentation"

# Real Computer Vision Inference Configuration
# Ensures genuine inference is executed on user-uploaded test images
ENABLE_YOLO_INFERENCE=true
ENABLE_DEMO_FALLBACK=false
YOLO_MODEL_PATH="models/yolov8s_rdd2022.pt"
WASTE_MODEL_PATH="models/taco_yolo11s.pt"
YOLO_CONFIDENCE_THRESHOLD=0.15
WASTE_CONFIDENCE_THRESHOLD=0.20
YOLO_IOU_THRESHOLD=0.45
YOLO_IMAGE_SIZE=640
YOLO_DEVICE="cpu"

# GIS Coordinates (Mumbai Region Default)
DEFAULT_LATITUDE=19.0760
DEFAULT_LONGITUDE=72.8777
GEODECODE_CACHE_ENABLED=true

# Security, Upload Limits & CORS Configuration
MAX_UPLOAD_SIZE_MB=10
CIVILENS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
CIVILENS_AUTH_SECRET_KEY="presentation-secret-key-do-not-use-in-production"
CIVILENS_ALLOW_DEV_TOKENS=true

# Local Demo Accounts for Presentation Access
CIVILENS_DEV_CITIZEN_PASSWORD="Citizen@123"
CIVILENS_DEV_INSPECTOR_PASSWORD="Inspector@123"
CIVILENS_DEV_ADMIN_PASSWORD="Admin@123"
