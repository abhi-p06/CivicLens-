# Server Configuration
CIVILENS_PORT=8000
CIVILENS_HOST="0.0.0.0"
CIVILENS_ENV="development"

# Feature Flags & Fallbacks
ENABLE_DEMO_FALLBACK=true
ENABLE_YOLO_INFERENCE=true
YOLO_MODEL_PATH="models/yolov8n_rdd.pt"

# GIS Settings (Default: Mumbai Region)
DEFAULT_LATITUDE=19.0760
DEFAULT_LONGITUDE=72.8777
GEODECODE_CACHE_ENABLED=true
